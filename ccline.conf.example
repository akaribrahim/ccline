# ccline config — copy to ~/.claude/ccline.conf and edit.
# Every key can also be set as an environment variable (env wins over file).

# Visual style: plain | bars | powerline
CCLINE_STYLE=plain

# Color depth: auto | truecolor | 256 | 16
# auto detects the terminal (Terminal.app -> 256, iTerm/WT/VSCode -> truecolor).
CCLINE_COLOR=auto

# Glyphs: auto | 1 (ASCII only) | 0 (Unicode)
# auto uses ASCII on legacy Windows console, Unicode elsewhere.
CCLINE_ASCII=auto

# Directory segment: full | name
# full is the whole path with $HOME folded to ~ — the only form that says which
# project a worktree belongs to, since Claude Code parks worktrees at
# <project>/.claude/worktrees/<name> and the basename is just the worktree.
# name shows the basename alone.
CCLINE_DIR=full

# Git worktree segment: auto | 0
# auto marks a linked worktree with "⑂" (handy when each terminal is a different
# worktree); 0 hides it. The name follows the glyph only when it isn't already
# in the directory segment — i.e. only under CCLINE_DIR=name.
CCLINE_WORKTREE=auto

# Tint the directory segment per worktree: auto | 0
# Each worktree gets its own colour (from its position in `git worktree list`,
# so two worktrees can never collide on the same one); the main tree keeps the
# default cyan. Lets you tell one worktree tab from another at a glance.
CCLINE_WT_COLOR=auto

# Burn-rate projection on the 5h / 7d limits: auto | 0
# "5h 30% →173%" = at this rate the window ends at 173%, i.e. you hit the wall
# before it resets. Computed locally from resets_at; silent while you're under
# CCLINE_PACE_WARN, and for the first 15% of a window (too noisy to project).
CCLINE_PACE=auto
CCLINE_PACE_WARN=90

# Pull-request segment ("#42 ✓" / "#42 ✗"): auto | 0. Hidden when the branch
# has no PR.
CCLINE_PR=auto

# Session name: auto | tmux | 0
# auto is Claude Code's name for it (--name, /rename, or the generated title);
# tmux is the name of the tmux session it runs in, falling back to auto
# outside tmux — handy when every conversation gets a tmux session of its own.
# CCLINE_NAME_TRIM drops a launcher's prefix: "team- chat-" shows "team-auth"
# as "auth". Space-separated; the first one that matches wins.
CCLINE_NAME=auto
CCLINE_NAME_TRIM=

# "📱" while Remote Control is on (the session is reachable from claude.ai or the
# Claude app): auto | 0
CCLINE_RC=auto

# Percentage thresholds that drive the green -> yellow -> orange -> red colour.
CCLINE_WARN=50
CCLINE_HIGH=75
CCLINE_CRIT=90

# How often the line re-renders is NOT set here — it lives in settings.json:
#
#   "statusLine": { "type": "command", "command": "...", "refreshInterval": 10 }
#
# Claude Code re-runs the command on conversation events; refreshInterval adds a
# timer (seconds, min 1) so a window that resets while you are idle stops showing
# a percentage we know to be wrong, the pace projection keeps moving, and the git
# segment notices branch changes. The installer writes 10.
